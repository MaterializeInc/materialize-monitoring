// Custom components for the gateway's cloud provider pulls. This file deploys:
// the chart includes it in every gateway config, where it is inert until
// something instantiates it.
//
// The shape lives here, validated and typed; the count lives in the chart. Each
// `declare` below is one pull, with its metric set fixed, and the chart's
// `mzmon.alloyGateway.pipeline.provider` renders one instance per resource
// named in `pipeline.metrics.provider.*`. A `declare` body cannot repeat a
// block, which is why CloudWatch takes one instance per resource and why the
// metric sets are not values.
//
// Every pull ends in `provider_scrape`: the `instance` pin and the clustered
// scrape. Clustering is what makes the provider be called once per interval
// however many gateway replicas there are. Both exporters call the provider on
// scrape, and export an identical target on every replica, so exactly one
// replica owns it.
//
// `forward_to` is a single receiver, not a list: the chart passes
// `otelcol.receiver.prometheus.inputBridge.receiver`.

declare "provider_scrape" {
	argument "targets" {
		comment = "The exporter's targets export."
	}

	argument "instance" {
		comment = "The `instance` label for every series. The exporter sets it to a hash of its own arguments, which changes whenever they do."
	}

	argument "forward_to" {
		comment = "One metrics receiver."
	}

	argument "scrape_interval" { }

	argument "scrape_timeout" {
		comment = "Must not exceed scrape_interval, or the gateway fails to start."
	}

	argument "honor_timestamps" {
		optional = true
		default  = true
		comment  = "False stamps every sample at the scrape, for a pull whose newest point can be hours old and would otherwise be refused as stale."
	}

	discovery.relabel "pin" {
		targets = argument.targets.value

		rule {
			target_label = "instance"
			replacement  = argument.instance.value
		}
	}

	prometheus.scrape "provider" {
		targets = discovery.relabel.pin.output
		forward_to = [
			argument.forward_to.value,
		]
		scrape_interval = argument.scrape_interval.value
		scrape_timeout = argument.scrape_timeout.value
		honor_timestamps = argument.honor_timestamps.value
		honor_metadata = true

		clustering {
			enabled = true
		}
	}
}

declare "provider_cloudwatch_rds" {
	argument "instance_id" {
		comment = "The DBInstanceIdentifier."
	}

	argument "region" { }

	argument "forward_to" { }

	argument "scrape_interval" { }

	argument "scrape_timeout" { }

	prometheus.exporter.cloudwatch "rds" {
		sts_region = argument.region.value

		static "rds" {
			regions = [
				argument.region.value,
			]
			namespace = "AWS/RDS"
			nil_to_zero = false
			dimensions = {
				DBInstanceIdentifier = argument.instance_id.value,
			}

			metric {
				name = "CPUUtilization"
				statistics = [
					"Average",
					"Maximum",
				]
				period = "5m"
				length = "10m"
			}

			metric {
				name = "CPUCreditBalance"
				statistics = [
					"Minimum",
				]
				period = "5m"
				length = "10m"
			}

			metric {
				name = "FreeableMemory"
				statistics = [
					"Minimum",
				]
				period = "5m"
				length = "10m"
			}

			metric {
				name = "FreeStorageSpace"
				statistics = [
					"Minimum",
				]
				period = "5m"
				length = "10m"
			}

			metric {
				name = "DatabaseConnections"
				statistics = [
					"Maximum",
				]
				period = "5m"
				length = "10m"
			}

			metric {
				name = "ReadLatency"
				statistics = [
					"Average",
				]
				period = "5m"
				length = "10m"
			}

			metric {
				name = "WriteLatency"
				statistics = [
					"Average",
				]
				period = "5m"
				length = "10m"
			}

			metric {
				name = "DiskQueueDepth"
				statistics = [
					"Average",
				]
				period = "5m"
				length = "10m"
			}

			metric {
				name = "BurstBalance"
				statistics = [
					"Minimum",
				]
				period = "5m"
				length = "10m"
			}

			metric {
				name = "EBSIOBalance%"
				statistics = [
					"Minimum",
				]
				period = "5m"
				length = "10m"
			}

			metric {
				name = "EBSByteBalance%"
				statistics = [
					"Minimum",
				]
				period = "5m"
				length = "10m"
			}

			metric {
				name = "MaximumUsedTransactionIDs"
				statistics = [
					"Maximum",
				]
				period = "5m"
				length = "10m"
			}
		}
	}

	provider_scrape "rds" {
		targets         = prometheus.exporter.cloudwatch.rds.targets
		instance        = argument.instance_id.value
		forward_to      = argument.forward_to.value
		scrape_interval = argument.scrape_interval.value
		scrape_timeout  = argument.scrape_timeout.value
	}
}

declare "provider_cloudwatch_s3" {
	argument "bucket" {
		comment = "The bucket name."
	}

	argument "region" { }

	argument "forward_to" { }

	argument "scrape_interval" { }

	argument "scrape_timeout" { }

	prometheus.exporter.cloudwatch "s3" {
		sts_region = argument.region.value

		static "s3" {
			regions = [
				argument.region.value,
			]
			namespace = "AWS/S3"
			nil_to_zero = false
			dimensions = {
				BucketName  = argument.bucket.value,
				StorageType = "StandardStorage",
			}

			metric {
				name = "BucketSizeBytes"
				statistics = [
					"Average",
				]
				period = "24h"
				length = "48h"
			}
		}

		static "s3" {
			regions = [
				argument.region.value,
			]
			namespace = "AWS/S3"
			nil_to_zero = false
			dimensions = {
				BucketName  = argument.bucket.value,
				StorageType = "AllStorageTypes",
			}

			metric {
				name = "NumberOfObjects"
				statistics = [
					"Average",
				]
				period = "24h"
				length = "48h"
			}
		}
	}

	provider_scrape "s3" {
		targets         = prometheus.exporter.cloudwatch.s3.targets
		instance        = argument.bucket.value
		forward_to      = argument.forward_to.value
		scrape_interval = argument.scrape_interval.value
		scrape_timeout  = argument.scrape_timeout.value
	}
}

declare "provider_cloudwatch_eks" {
	argument "clusters" {
		comment = "EKS cluster names."
	}

	argument "region" { }

	argument "forward_to" { }

	argument "scrape_interval" { }

	argument "scrape_timeout" { }

	prometheus.exporter.cloudwatch "eks" {
		sts_region = argument.region.value
		discovery_exported_tags = {
			"AWS/EC2"         = [
				"karpenter.sh/nodepool",
				"eks:nodegroup-name",
			],
			"AWS/AutoScaling" = [
				"eks:nodegroup-name",
			],
		}

		discovery {
			type = "AWS/EC2"
			regions = [
				argument.region.value,
			]
			search_tags = {
				"aws:eks:cluster-name" = string.format("^(%s)$", string.join(argument.clusters.value, "|")),
			}
			dimension_name_requirements = [
				"InstanceId",
			]
			nil_to_zero = false

			metric {
				name = "StatusCheckFailed_System"
				statistics = [
					"Maximum",
				]
				period = "5m"
				length = "10m"
			}

			metric {
				name = "StatusCheckFailed_Instance"
				statistics = [
					"Maximum",
				]
				period = "5m"
				length = "10m"
			}

			metric {
				name = "StatusCheckFailed_AttachedEBS"
				statistics = [
					"Maximum",
				]
				period = "5m"
				length = "10m"
			}
		}

		discovery {
			type = "AWS/AutoScaling"
			regions = [
				argument.region.value,
			]
			search_tags = {
				"eks:cluster-name" = string.format("^(%s)$", string.join(argument.clusters.value, "|")),
			}
			dimension_name_requirements = [
				"AutoScalingGroupName",
			]
			nil_to_zero = false

			metric {
				name = "GroupDesiredCapacity"
				statistics = [
					"Average",
				]
				period = "5m"
				length = "10m"
			}

			metric {
				name = "GroupInServiceInstances"
				statistics = [
					"Average",
				]
				period = "5m"
				length = "10m"
			}

			metric {
				name = "GroupPendingInstances"
				statistics = [
					"Average",
				]
				period = "5m"
				length = "10m"
			}

			metric {
				name = "GroupMaxSize"
				statistics = [
					"Average",
				]
				period = "5m"
				length = "10m"
			}
		}

		static "vcpu" {
			regions = [
				argument.region.value,
			]
			namespace = "AWS/Usage"
			nil_to_zero = false
			dimensions = {
				Service  = "EC2",
				Type     = "Resource",
				Resource = "vCPU",
				Class    = "Standard/OnDemand",
			}

			metric {
				name = "ResourceCount"
				statistics = [
					"Maximum",
				]
				period = "5m"
				length = "10m"
			}
		}
	}

	provider_scrape "eks" {
		targets         = prometheus.exporter.cloudwatch.eks.targets
		instance        = "eks"
		forward_to      = prometheus.relabel.eks.receiver
		scrape_interval = argument.scrape_interval.value
		scrape_timeout  = argument.scrape_timeout.value
	}

	prometheus.relabel "eks" {
		forward_to = [
			argument.forward_to.value,
		]

		rule {
			action = "drop"
			source_labels = [
				"__name__",
			]
			regex = "aws_[a-z0-9]+_info"
		}
	}
}

declare "provider_gcp_cloudsql" {
	argument "project_id" { }

	argument "database_ids" {
		comment = "Cloud SQL database_ids, as project:instance."
	}

	argument "request_interval" {
		comment = "How far back each pull reaches. Only the newest point per series is kept."
	}

	argument "forward_to" { }

	argument "scrape_interval" { }

	argument "scrape_timeout" { }

	prometheus.exporter.gcp "cloudsql" {
		project_ids = [
			argument.project_id.value,
		]
		metrics_prefixes = [
			"cloudsql.googleapis.com/database/cpu/utilization",
			"cloudsql.googleapis.com/database/memory/utilization",
			"cloudsql.googleapis.com/database/disk/utilization",
			"cloudsql.googleapis.com/database/postgresql/num_backends",
			"cloudsql.googleapis.com/database/postgresql/transaction_id_utilization",
			"cloudsql.googleapis.com/database/up",
		]
		extra_filters = [
			string.format("cloudsql.googleapis.com/database:resource.labels.database_id=one_of(\"%s\")", string.join(argument.database_ids.value, "\",\"")),
		]
		request_interval = argument.request_interval.value
		ingest_delay = true
	}

	provider_scrape "cloudsql" {
		targets         = prometheus.exporter.gcp.cloudsql.targets
		instance        = "cloudsql"
		forward_to      = argument.forward_to.value
		scrape_interval = argument.scrape_interval.value
		scrape_timeout  = argument.scrape_timeout.value
	}
}

declare "provider_gcp_gcs" {
	argument "project_id" { }

	argument "buckets" {
		comment = "GCS bucket names."
	}

	argument "request_interval" {
		comment = "How far back each pull reaches. Only the newest point per series is kept."
	}

	argument "forward_to" { }

	argument "scrape_interval" { }

	argument "scrape_timeout" { }

	prometheus.exporter.gcp "gcs" {
		project_ids = [
			argument.project_id.value,
		]
		metrics_prefixes = [
			"storage.googleapis.com/storage/v2/total_bytes",
			"storage.googleapis.com/storage/v2/total_count",
		]
		extra_filters = [
			string.format("storage.googleapis.com:resource.labels.bucket_name=one_of(\"%s\")", string.join(argument.buckets.value, "\",\"")),
		]
		request_interval = argument.request_interval.value
		ingest_delay = true
	}

	provider_scrape "gcs" {
		targets         = prometheus.exporter.gcp.gcs.targets
		instance        = "gcs"
		forward_to      = argument.forward_to.value
		scrape_interval = argument.scrape_interval.value
		scrape_timeout  = argument.scrape_timeout.value
	}
}

declare "provider_gcp_compute_quota" {
	argument "project_id" { }

	argument "regions" {
		comment = "Compute Engine regions, such as us-east1."
	}

	argument "request_interval" {
		comment = "How far back each pull reaches. Only the newest point per series is kept."
	}

	argument "forward_to" { }

	argument "scrape_interval" { }

	argument "scrape_timeout" { }

	prometheus.exporter.gcp "quota" {
		project_ids = [
			argument.project_id.value,
		]
		metrics_prefixes = [
			"compute.googleapis.com/quota/cpus_per_vm_family/usage",
			"compute.googleapis.com/quota/cpus_per_vm_family/limit",
			"compute.googleapis.com/quota/local_ssd_total_storage_per_vm_family/usage",
			"compute.googleapis.com/quota/local_ssd_total_storage_per_vm_family/limit",
		]
		extra_filters = [
			string.format("compute.googleapis.com/quota:resource.labels.location=monitoring.regex.full_match(\"(%s)(-[a-z])?\")", string.join(argument.regions.value, "|")),
		]
		request_interval = "24h"
		ingest_delay = true
	}

	prometheus.exporter.gcp "quota_exceeded" {
		project_ids = [
			argument.project_id.value,
		]
		metrics_prefixes = [
			"compute.googleapis.com/quota/cpus_per_vm_family/exceeded",
			"compute.googleapis.com/quota/local_ssd_total_storage_per_vm_family/exceeded",
		]
		extra_filters = [
			string.format("compute.googleapis.com/quota:resource.labels.location=monitoring.regex.full_match(\"(%s)(-[a-z])?\")", string.join(argument.regions.value, "|")),
		]
		request_interval = argument.request_interval.value
		ingest_delay = true
	}

	provider_scrape "quota" {
		targets          = prometheus.exporter.gcp.quota.targets
		instance         = "compute_quota"
		forward_to       = argument.forward_to.value
		scrape_interval  = argument.scrape_interval.value
		scrape_timeout   = argument.scrape_timeout.value
		honor_timestamps = false
	}

	provider_scrape "quota_exceeded" {
		targets         = prometheus.exporter.gcp.quota_exceeded.targets
		instance        = "compute_quota_exceeded"
		forward_to      = argument.forward_to.value
		scrape_interval = argument.scrape_interval.value
		scrape_timeout  = argument.scrape_timeout.value
	}
}

declare "provider_azure_postgres" {
	argument "subscription_id" { }

	argument "servers" {
		comment = "Flexible Server names, not FQDNs or resource IDs."
	}

	argument "cloud_environment" {
		comment = "azurecloud, azurechinacloud or azureusgovernmentcloud."
	}

	argument "forward_to" { }

	argument "scrape_interval" { }

	argument "scrape_timeout" { }

	prometheus.exporter.azure "postgres" {
		subscriptions = [
			argument.subscription_id.value,
		]
		resource_type = "Microsoft.DBforPostgreSQL/flexibleServers"
		metrics = [
			"cpu_percent",
			"cpu_credits_remaining",
			"memory_percent",
			"storage_percent",
			"active_connections",
			"connections_failed",
			"disk_queue_depth",
			"disk_iops_consumed_percentage",
			"disk_bandwidth_consumed_percentage",
			"maximum_used_transactionIDs",
			"is_db_alive",
		]
		resource_graph_query_filter = string.format("where name in~ ('%s')", string.join(argument.servers.value, "','"))
		metric_aggregations = [
			"average",
			"maximum",
			"minimum",
			"total",
		]
		timespan = "PT10M"
		interval = "PT5M"
		included_resource_tags = []
		azure_cloud_environment = argument.cloud_environment.value
	}

	provider_scrape "postgres" {
		targets         = prometheus.exporter.azure.postgres.targets
		instance        = "postgres"
		forward_to      = prometheus.relabel.postgres.receiver
		scrape_interval = argument.scrape_interval.value
		scrape_timeout  = argument.scrape_timeout.value
	}

	prometheus.relabel "postgres" {
		forward_to = [
			argument.forward_to.value,
		]

		rule {
			action = "keep"
			source_labels = [
				"__name__",
			]
			regex = "azure_microsoft_dbforpostgresql_flexibleservers_(cpu_percent_(average|maximum)|cpu_credits_remaining_minimum|memory_percent_maximum|storage_percent_maximum|active_connections_maximum|connections_failed_total|disk_queue_depth_average|disk_(iops|bandwidth)_consumed_percentage_maximum|maximum_used_transactionids_maximum|is_db_alive_minimum)_[a-z]+|up|scrape_.+"
		}
	}
}

declare "provider_azure_blob" {
	argument "subscription_id" { }

	argument "storage_accounts" {
		comment = "Storage account names."
	}

	argument "cloud_environment" {
		comment = "azurecloud, azurechinacloud or azureusgovernmentcloud."
	}

	argument "forward_to" { }

	argument "scrape_interval" { }

	argument "scrape_timeout" { }

	prometheus.exporter.azure "capacity" {
		subscriptions = [
			argument.subscription_id.value,
		]
		resource_type = "Microsoft.Storage/storageAccounts"
		metrics = [
			"BlobCapacity",
			"BlobCount",
		]
		resource_graph_query_filter = string.format("where name in~ ('%s')", string.join(argument.storage_accounts.value, "','"))
		metric_aggregations = [
			"average",
		]
		timespan = "P1D"
		interval = "PT1H"
		metric_namespace = "Microsoft.Storage/storageAccounts/blobServices"
		included_resource_tags = []
		azure_cloud_environment = argument.cloud_environment.value
	}

	prometheus.exporter.azure "requests" {
		subscriptions = [
			argument.subscription_id.value,
		]
		resource_type = "Microsoft.Storage/storageAccounts"
		metrics = [
			"Availability",
			"SuccessServerLatency",
			"SuccessE2ELatency",
		]
		resource_graph_query_filter = string.format("where name in~ ('%s')", string.join(argument.storage_accounts.value, "','"))
		metric_aggregations = [
			"average",
		]
		timespan = "PT10M"
		interval = "PT5M"
		metric_namespace = "Microsoft.Storage/storageAccounts/blobServices"
		included_resource_tags = []
		azure_cloud_environment = argument.cloud_environment.value
	}

	provider_scrape "capacity" {
		targets         = prometheus.exporter.azure.capacity.targets
		instance        = "blob_capacity"
		forward_to      = argument.forward_to.value
		scrape_interval = argument.scrape_interval.value
		scrape_timeout  = argument.scrape_timeout.value
	}

	provider_scrape "requests" {
		targets         = prometheus.exporter.azure.requests.targets
		instance        = "blob_requests"
		forward_to      = argument.forward_to.value
		scrape_interval = argument.scrape_interval.value
		scrape_timeout  = argument.scrape_timeout.value
	}
}

declare "provider_azure_aks" {
	argument "subscription_id" { }

	argument "clusters" {
		comment = "AKS cluster names, not resource IDs."
	}

	argument "cloud_environment" {
		comment = "azurecloud, azurechinacloud or azureusgovernmentcloud."
	}

	argument "forward_to" { }

	argument "scrape_interval" { }

	argument "scrape_timeout" { }

	prometheus.exporter.azure "autoscaler" {
		subscriptions = [
			argument.subscription_id.value,
		]
		resource_type = "Microsoft.ContainerService/managedClusters"
		metrics = [
			"cluster_autoscaler_unschedulable_pods_count",
			"cluster_autoscaler_cluster_safe_to_autoscale",
			"cluster_autoscaler_scale_down_in_cooldown",
			"cluster_autoscaler_unneeded_nodes_count",
		]
		resource_graph_query_filter = string.format("where name in~ ('%s')", string.join(argument.clusters.value, "','"))
		metric_aggregations = [
			"maximum",
			"minimum",
		]
		timespan = "PT10M"
		interval = "PT5M"
		included_resource_tags = []
		azure_cloud_environment = argument.cloud_environment.value
	}

	prometheus.exporter.azure "nodes" {
		subscriptions = [
			argument.subscription_id.value,
		]
		resource_type = "Microsoft.Compute/virtualMachineScaleSets"
		metrics = [
			"VmAvailabilityMetric",
		]
		resource_graph_query_filter = string.format("extend nodeResourceGroup = tolower(resourceGroup) | join kind=inner (Resources | where type =~ 'microsoft.containerservice/managedclusters' and name in~ ('%s') | project nodeResourceGroup = tolower(tostring(properties.nodeResourceGroup))) on nodeResourceGroup", string.join(argument.clusters.value, "','"))
		metric_aggregations = [
			"minimum",
		]
		timespan = "PT10M"
		interval = "PT5M"
		included_dimensions = [
			"VMName",
			"Context",
		]
		included_resource_tags = []
		azure_cloud_environment = argument.cloud_environment.value
	}

	provider_scrape "autoscaler" {
		targets         = prometheus.exporter.azure.autoscaler.targets
		instance        = "aks_autoscaler"
		forward_to      = prometheus.relabel.autoscaler.receiver
		scrape_interval = argument.scrape_interval.value
		scrape_timeout  = argument.scrape_timeout.value
	}

	provider_scrape "nodes" {
		targets         = prometheus.exporter.azure.nodes.targets
		instance        = "aks_nodes"
		forward_to      = argument.forward_to.value
		scrape_interval = argument.scrape_interval.value
		scrape_timeout  = argument.scrape_timeout.value
	}

	prometheus.relabel "autoscaler" {
		forward_to = [
			argument.forward_to.value,
		]

		rule {
			action = "keep"
			source_labels = [
				"__name__",
			]
			regex = "azure_microsoft_containerservice_managedclusters_cluster_autoscaler_((unschedulable_pods_count|scale_down_in_cooldown|unneeded_nodes_count)_maximum|cluster_safe_to_autoscale_minimum)_[a-z]+|up|scrape_.+"
		}
	}
}
