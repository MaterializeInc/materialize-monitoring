// This pipeline defines the flow of metrics through the Alloy gateway, from
// ingestion to their final destination.

otelcol.receiver.prometheus "inputBridge" {
	output {
		metrics = [
			otelcol.processor.transform.inputMetricProcessor.input,
		]
	}
}

prometheus.operator.podmonitors "default" {
	forward_to = [
		otelcol.receiver.prometheus.inputBridge.receiver,
	]

	clustering {
		enabled = true
	}

	scrape {
		default_scrape_interval = coalesce(sys.env("GATEWAY_SCRAPE_INTERVAL"), "30s")
		default_scrape_timeout  = coalesce(sys.env("GATEWAY_SCRAPE_TIMEOUT"), "10s")
		honor_metadata          = true
	}

	rule {
		action = "drop"
		source_labels = [
			"__meta_kubernetes_pod_phase",
		]
		regex = "Pending|Succeeded|Failed"
	}

	rule {
		source_labels = [
			"__meta_kubernetes_pod_label_k8s_app",
		]
		target_label = "app"
		regex = "(.+)"
	}

	rule {
		source_labels = [
			"__meta_kubernetes_pod_label_app",
		]
		target_label = "app"
		regex = "(.+)"
	}

	rule {
		source_labels = [
			"__meta_kubernetes_pod_label_app_kubernetes_io_name",
		]
		target_label = "app"
		regex = "(.+)"
	}
}

prometheus.operator.servicemonitors "default" {
	forward_to = [
		otelcol.receiver.prometheus.inputBridge.receiver,
	]

	clustering {
		enabled = true
	}

	scrape {
		default_scrape_interval = coalesce(sys.env("GATEWAY_SCRAPE_INTERVAL"), "30s")
		default_scrape_timeout  = coalesce(sys.env("GATEWAY_SCRAPE_TIMEOUT"), "10s")
		honor_metadata          = true
	}

	rule {
		action = "drop"
		source_labels = [
			"__meta_kubernetes_pod_phase",
		]
		regex = "Pending|Succeeded|Failed"
	}

	rule {
		source_labels = [
			"__meta_kubernetes_pod_label_k8s_app",
		]
		target_label = "app"
		regex = "(.+)"
	}

	rule {
		source_labels = [
			"__meta_kubernetes_pod_label_app",
		]
		target_label = "app"
		regex = "(.+)"
	}

	rule {
		source_labels = [
			"__meta_kubernetes_pod_label_app_kubernetes_io_name",
		]
		target_label = "app"
		regex = "(.+)"
	}
}

otelcol.processor.transform "inputMetricProcessor" {
	error_mode = "ignore"

	metric_statements {
		context = "metric"
		statements = [
			"extract_count_metric(true) where ((metric.type == METRIC_DATA_TYPE_HISTOGRAM and IsMatch(Concat([metric.name, \"_bucket\"], \"\"), \"^(?:" + sys.env("GATEWAY_DENY_METRICS") + ")$\")) or (metric.type == METRIC_DATA_TYPE_SUMMARY and IsMatch(metric.name, \"^(?:" + sys.env("GATEWAY_DENY_METRICS") + ")$\"))) and not IsMatch(Concat([metric.name, \"_count\"], \"\"), \"^(?:" + sys.env("GATEWAY_DENY_METRICS") + ")$\")",
			"extract_sum_metric(true) where ((metric.type == METRIC_DATA_TYPE_HISTOGRAM and IsMatch(Concat([metric.name, \"_bucket\"], \"\"), \"^(?:" + sys.env("GATEWAY_DENY_METRICS") + ")$\")) or (metric.type == METRIC_DATA_TYPE_SUMMARY and IsMatch(metric.name, \"^(?:" + sys.env("GATEWAY_DENY_METRICS") + ")$\"))) and not IsMatch(Concat([metric.name, \"_sum\"], \"\"), \"^(?:" + sys.env("GATEWAY_DENY_METRICS") + ")$\")",
		]
	}

	output {
		metrics = [
			otelcol.processor.filter.inputMetricDeny.input,
		]
	}
}

otelcol.processor.filter "inputMetricDeny" {
	metric_conditions {
		context = "metric"
		conditions = [
			"IsMatch(metric.name, \"^(?:" + sys.env("GATEWAY_DENY_METRICS") + ")$\")",
			"metric.type == METRIC_DATA_TYPE_HISTOGRAM and IsMatch(Concat([metric.name, \"_bucket\"], \"\"), \"^(?:" + sys.env("GATEWAY_DENY_METRICS") + ")$\")",
		]
	}

	output {
		metrics = [
			otelcol.processor.memory_limiter.outputMemoryLimiter.input,
		]
	}
}

otelcol.exporter.prometheus "outputBridge" {
	forward_to = [
		prometheus.relabel.egress.receiver,
	]
	add_metric_suffixes = false
}
