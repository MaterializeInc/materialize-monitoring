// BUILD-TIME stand-in for the chart's provider instances. This is NOT what
// deploys.
//
// gateway-provider.yaml holds the custom components and deploys as-is. What
// the chart adds at install is only instances of them, one per resource, from
// `mzmon.alloyGateway.pipeline.provider` in
// charts/materialize-monitoring/templates/_alloy_provider_helpers.tpl.
//
// This file makes one instance of each, with the arguments the chart passes,
// so `make pipelines` checks those argument names against the components at
// the Alloy version CI pins — `alloy validate` rejects an argument a
// `declare` does not have. Keep it in step with the helper's instances. The
// helper is the source of truth.

provider_cloudwatch_rds "rds_example_db" {
	instance_id     = "example-db"
	region          = "us-east-1"
	forward_to      = otelcol.receiver.prometheus.inputBridge.receiver
	scrape_interval = "5m"
	scrape_timeout  = "2m"
}

provider_cloudwatch_s3 "s3_example_bucket" {
	bucket          = "example-bucket"
	region          = "us-east-1"
	forward_to      = otelcol.receiver.prometheus.inputBridge.receiver
	scrape_interval = "5m"
	scrape_timeout  = "2m"
}

provider_gcp_cloudsql "provider" {
	project_id = "example-project"
	database_ids = [
		"example-project:example-pg",
	]
	request_interval = "10m"
	forward_to = otelcol.receiver.prometheus.inputBridge.receiver
	scrape_interval = "5m"
	scrape_timeout = "2m"
}

provider_gcp_gcs "provider" {
	project_id = "example-project"
	buckets = [
		"example-bucket",
	]
	request_interval = "10m"
	forward_to = otelcol.receiver.prometheus.inputBridge.receiver
	scrape_interval = "5m"
	scrape_timeout = "2m"
}

provider_azure_postgres "provider" {
	subscription_id = "00000000-0000-0000-0000-000000000000"
	servers = [
		"example-pg",
	]
	cloud_environment = "azurecloud"
	forward_to = otelcol.receiver.prometheus.inputBridge.receiver
	scrape_interval = "5m"
	scrape_timeout = "2m"
}

provider_azure_blob "provider" {
	subscription_id = "00000000-0000-0000-0000-000000000000"
	storage_accounts = [
		"examplestorage",
	]
	cloud_environment = "azurecloud"
	forward_to = otelcol.receiver.prometheus.inputBridge.receiver
	scrape_interval = "5m"
	scrape_timeout = "2m"
}
